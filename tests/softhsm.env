# Configuration for running the suite against SoftHSM2.
#
# Committed, unlike tests/test.env: this is the development and CI setup, so it
# should be the same for everyone.  Provision the token first, then select this
# file:
#
#   tests/provision-softhsm.sh
#   SQ_PKCS11_TEST_ENV=tests/softhsm.env uv run pytest
#
# Relative paths below resolve against the repository root.
#
# What it does NOT cover: a two-tier `cert-export` needs two C_Login calls
# against one token and SoftHSM refuses the second, so those tests skip here and
# run only against module-protected keys on a real HSM.  See README.md.

# SoftHSM's module moves between distributions: /usr/lib/softhsm on
# Debian/Ubuntu, /usr/lib64/pkcs11 on Fedora and EL.  The default is the
# Debian/Ubuntu one; provision-softhsm.sh prints the SOFTHSM_MODULE export to
# use if it found the module somewhere else.
PKCS11_MODULE_PATH=${SOFTHSM_MODULE:-/usr/lib/softhsm/libsofthsm2.so}

# Written by provision-softhsm.sh, along with the token store it names.
SOFTHSM2_CONF=tests/softhsm/softhsm2.conf
SQ_PKCS11_TEST_PIN_FILE=tests/softhsm/pin

# The keys provision-softhsm.sh generates.  RSA-4096 and P-384 mirror the
# nShield test keys; the three P-256 keys stand in for the two-tier tiers.
SQ_PKCS11_NSHIELD_TEST_RSA=sqp11-rsa
SQ_PKCS11_NSHIELD_TEST_EC=sqp11-ec
SQ_PKCS11_NSHIELD_TEST_PRIMARY=sqp11-primary
SQ_PKCS11_NSHIELD_TEST_SUBKEY=sqp11-subkey
SQ_PKCS11_NSHIELD_TEST_SUBKEY2=sqp11-subkey2
