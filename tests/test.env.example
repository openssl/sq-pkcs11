# Configuration for the nShield integration test suite.
#
# Copy this file to tests/test.env and edit the values to match
# the keys provisioned in your Security World.  The integration suite
# (tests/, run with pytest) reads it; an explicit environment
# variable always wins over a value here.  Anything missing makes the
# affected tests skip with the reason.
#
# tests/nshield/test.env is in .gitignore — do not commit your local copy.

# Path to the nShield PKCS#11 vendor module.
PKCS11_MODULE_PATH=/opt/nfast/toolkits/pkcs11/libcknfast.so

# CKA_LABEL of the test keys.  All five should be module-protected (no
# softcard / OCS) — the suite is unattended and cannot present cards.
# For a PIN-protected token such as SoftHSM2, set SQ_PKCS11_TEST_PIN_FILE
# to a file holding the PIN; see tests/README.md.
#
# For SoftHSM2 there is nothing to copy: tests/softhsm.env is committed.
# Run tests/provision-softhsm.sh, then
#   SQ_PKCS11_TEST_ENV=tests/softhsm.env uv run pytest
SQ_PKCS11_NSHIELD_TEST_RSA=sq-pkcs11-nshield-test-rsa4096
SQ_PKCS11_NSHIELD_TEST_EC=sq-pkcs11-nshield-test-p384
SQ_PKCS11_NSHIELD_TEST_PRIMARY=sq-pkcs11-nshield-test-primary
SQ_PKCS11_NSHIELD_TEST_SUBKEY=sq-pkcs11-nshield-test-subkey
# Second signing-capable subkey, used by the cert-export --merge-cert
# rotation test to confirm both old and new subkeys remain present.
SQ_PKCS11_NSHIELD_TEST_SUBKEY2=sq-pkcs11-nshield-test-subkey2
