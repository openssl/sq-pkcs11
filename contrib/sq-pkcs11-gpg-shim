#!/usr/bin/env bash
#
# sq-pkcs11-gpg-shim — a gpg(1)-compatible front end for `sq-pkcs11 sign`.
#
# Tools that sign through GnuPG usually do it by exec'ing a gpg command line
# rather than by linking a library.  `rpmsign --addsign` is the motivating
# case: it expands rpm's %__gpg_sign_cmd macro, which boils down to
#
#     gpg --no-verbose --no-armor [--digest-algo=X] -u "<_gpg_name>" \
#         -sbo <signature-file> -
#
# and requires the invoked binary to write a BINARY detached signature to the
# -o path and exit 0.  rpm then embeds those raw OpenPGP packets in the
# package header.  This script accepts that command line, translates it into
# an `sq-pkcs11 sign` invocation, and so lets any such tool sign against a
# PKCS#11 HSM without a private key on disk and without a gpg-agent.
#
# Two details of that contract are easy to miss and are both load-bearing, as
# measured on rpm 4.16.1.3 (EL9) and rpm 4.19.1.1 (EL10):
#
#   * the data to sign arrives on STDIN, not as a path.  Both versions pass `-`
#     as the file operand and pipe the package's header+payload in;
#   * rpm 4.19 first runs the configured gpg with `--version` and gives up if
#     that exits non-zero.
#
# What is supported: detached signing (binary or armored) and cleartext
# signing (`--clearsign`).  Nothing else — this is not a gpg replacement.
# Encryption, verification, key management and keyring access are all absent;
# asking for them is an error rather than a silent no-op.
#
# ─── Configuration ──────────────────────────────────────────────────────────
#
# The caller's command line carries the signing key name and the file paths.
# Everything sq-pkcs11 needs that gpg has no flag for comes from the
# environment:
#
#   PKCS11_MODULE_PATH      Vendor PKCS#11 library.  Required (or SQ_PKCS11_MODULE).
#   SQ_PKCS11_CERT          Published certificate; passed as --input-cert, which
#                           derives the key-creation time by matching the HSM
#                           key's public material.  Preferred over
#                           SQ_PKCS11_CREATION_TIME: nothing to keep in sync.
#   SQ_PKCS11_CREATION_TIME RFC 3339 key-creation time; passed as
#                           --creation-time.  One of these two is required —
#                           sq-pkcs11 refuses to guess (see its error text).
#   SQ_PKCS11_KEY_LABEL     CKA_LABEL to sign with when the caller passes no -u
#                           (rpm 4.19 omits it when %_gpg_name is unset).  An
#                           explicit -u wins over this.
#   SQ_PKCS11_PIN_FILE      Passed as --pin-file, for a softcard- or
#                           single-card-OCS-protected key.  Omit for a
#                           module-protected key, which is the unattended case.
#   SQ_PKCS11_BIN           sq-pkcs11 to run.  Default: `sq-pkcs11` on PATH.
#
# SQ_PKCS11_PIN and SQ_PKCS11_SUBKEY_PIN are actively removed from the
# environment before sq-pkcs11 runs.  Those variables switch sq-pkcs11 into
# PKCS#11 login mode; a module-protected key needs login mode None, and a
# value that merely happens to be exported in a CI environment would flip the
# mode and take the login-required-token code path — which fails, or worse
# picks a different slot.  Ambient credentials must not steer key selection,
# so the explicit SQ_PKCS11_PIN_FILE above is the only way in.
#
# ─── rpm macro overrides ────────────────────────────────────────────────────
#
# Point rpm's gpg at this script and name the HSM key:
#
#   rpmsign --addsign \
#       --define "_gpg_name <CKA_LABEL>" \
#       --define "__gpg $(command -v sq-pkcs11-gpg-shim)" \
#       package.rpm
#
# Overriding %__gpg keeps the distro's own %__gpg_sign_cmd, so the contract
# stays whatever that rpm version expects.  Both shapes shipped today work:
# rpm 4.16 (EL9) execve()s the binary directly and passes `--digest-algo X`,
# rpm 4.19 (EL10) goes through a shell, passes `--digest-algo=X`, and leaves
# the literal string `gpg` as the first argument.
#
# To pass extra sq-pkcs11 flags, override the whole command instead:
#
#   --define "__gpg_sign_cmd %{__gpg} gpg --no-verbose --no-armor \
#       -u %{_gpg_name} -sbo %{__signature_filename} %{__plaintext_filename}"
#
# The same works for ~/.rpmmacros or /etc/rpm/macros.d/, and %_gpg_name must
# be the HSM CKA_LABEL — not an email address or fingerprint, because -u is
# mapped to sq-pkcs11's --key-label.
#
set -euo pipefail

readonly PROG=${0##*/}

die() {
    printf '%s: %s\n' "$PROG" "$*" >&2
    exit 1
}

warn() {
    printf '%s: %s\n' "$PROG" "$*" >&2
}

# in_list <needle> <item>...
in_list() {
    local needle=$1 item
    shift
    for item in "$@"; do
        [[ $item == "$needle" ]] && return 0
    done
    return 1
}

# ---------------------------------------------------------------------------
# Argument parsing.
#
# Tolerant by design: a caller's gpg command line carries plenty of options
# that have no bearing on what we do (keyring paths, fd plumbing, verbosity),
# and rejecting them would mean chasing every distro's macro edits.  Those are
# consumed and dropped.  Options that would change the *meaning* of the
# operation are not silently dropped.
# ---------------------------------------------------------------------------

key_label=${SQ_PKCS11_KEY_LABEL:-}
output=
digest_algo=
armor=0
cleartext=0
positional=()

# Long options that take a value we have no use for.  The value must still be
# consumed, or it would be left behind as an operand and mistaken for the file
# to sign.
value_consuming_ignored=(
    --homedir --keyring --secret-keyring --primary-keyring --trustdb-name
    --options --passphrase --passphrase-fd --passphrase-file --pinentry-mode
    --status-fd --logger-fd --attribute-fd --command-fd --log-file
    --set-filename --comment --cert-digest-algo --compress-algo --compress-level
    --personal-digest-preferences --personal-cipher-preferences
    --personal-compress-preferences --trust-model --keyid-format --display-charset
    --s2k-digest-algo --s2k-cipher-algo --s2k-mode --s2k-count --sender
    --request-origin --known-notation --agent-program --dirmngr-program
)

while (($#)); do
    arg=$1
    shift
    case $arg in
    # ── things we act on ────────────────────────────────────────────────
    -u | --local-user | --default-key)
        (($#)) || die "$arg requires a value"
        key_label=$1
        shift
        ;;
    --local-user=* | --default-key=*)
        key_label=${arg#*=}
        ;;
    -o | --output)
        (($#)) || die "$arg requires a value"
        output=$1
        shift
        ;;
    --output=*)
        output=${arg#*=}
        ;;
    --armor | --armour | --enarmor)
        armor=1
        ;;
    --no-armor | --no-armour)
        armor=0
        ;;
    --clearsign | --clear-sign)
        cleartext=1
        ;;
    --digest-algo)
        (($#)) || die "$arg requires a value"
        digest_algo=$1
        shift
        ;;
    --digest-algo=*)
        digest_algo=${arg#*=}
        ;;

    # rpm 4.19 probes the configured gpg with `--version` before it signs
    # anything, and treats a non-zero exit as "gpg is broken" — so answering
    # this is load-bearing, not a nicety.  The first line is the machine-
    # readable part every gpg version banner starts with, and it is what a
    # caller sniffing for GnuPG matches on; the lines after it say plainly
    # what this actually is.
    --version)
        echo "gpg (GnuPG) 2.4.0"
        echo "$PROG: gpg-compatible signing front end for sq-pkcs11"
        "${SQ_PKCS11_BIN:-sq-pkcs11}" --version 2>/dev/null ||
            echo "sq-pkcs11: not found on PATH"
        exit 0
        ;;

    # End of options: everything left is an operand.  rpm 4.19 emits
    # `-sbo <sigfile> -- -`, so this arrives in practice.
    --)
        while (($#)); do
            positional+=("$1")
            shift
        done
        ;;

    # ── operations we cannot perform: fail, never pretend ───────────────
    --verify | --verify-files | --decrypt | --encrypt | --symmetric | \
        --list-keys | --list-secret-keys | --export | --export-secret-keys | \
        --import | --gen-key | --full-gen-key | --quick-gen-key | \
        --delete-key | --delete-secret-key | --edit-key | --sign-key | \
        --gen-revoke | --card-status | --card-edit | --change-pin)
        die "$arg is not supported; this shim only creates signatures with an HSM key.
sq-pkcs11 covers certificate export and revocation as its own subcommands;
everything else needs real gpg."
        ;;

    # ── boilerplate: understood, irrelevant, dropped ────────────────────
    --sign | -s | --detach-sign | --detach-sig | --textmode | -t | \
        --no-verbose | --verbose | -v | --quiet | -q | --batch | --no-batch | \
        --yes | --no-tty | --no-secmem-warning | --no-permission-warning | \
        --no-default-keyring | --no-options | --no-greeting | --no-armor-warning | \
        --emit-version | --no-emit-version | --no-mdc-warning | --force-v3-sigs | \
        --no-force-v3-sigs | --enable-progress-filter | --lock-never | \
        --lock-once | --lock-multiple | --always-trust | --trust-model-always | \
        --no-auto-check-trustdb | --no-random-seed-file | --utf8-strings | \
        --no-utf8-strings | --rfc4880 | --rfc2440 | --openpgp | --gnupg | \
        --no-use-agent | --use-agent | --debug-quick-random | --no-comments)
        ;;
    --*)
        # Split "--flag=value" so the bare name can be looked up.
        name=${arg%%=*}
        if in_list "$name" "${value_consuming_ignored[@]}"; then
            # Only eat a following token for the space-separated spelling.
            if [[ $arg != *=* ]] && (($#)); then
                shift
            fi
        else
            warn "ignoring unrecognised option $name"
        fi
        ;;

    # ── short-option clusters: -b, -sb, -sbo FILE, -uNAME ───────────────
    -?*)
        rest=${arg#-}
        while [[ -n $rest ]]; do
            opt=${rest:0:1}
            rest=${rest:1}
            case $opt in
            o)
                if [[ -n $rest ]]; then
                    output=$rest
                    rest=
                elif (($#)); then
                    output=$1
                    shift
                else
                    die "-o requires a value"
                fi
                ;;
            u)
                if [[ -n $rest ]]; then
                    key_label=$rest
                    rest=
                elif (($#)); then
                    key_label=$1
                    shift
                else
                    die "-u requires a value"
                fi
                ;;
            a) armor=1 ;;
            # sign / detach / textmode / verbose / quiet / dry-run: implied
            # or irrelevant.
            s | b | t | v | q | n) ;;
            *) warn "ignoring unrecognised option -$opt" ;;
            esac
        done
        ;;

    # ── operands ────────────────────────────────────────────────────────
    *)
        positional+=("$arg")
        ;;
    esac
done

# Both rpm versions expand %__gpg_sign_cmd to a command line that begins
# `<path-to-gpg> gpg --no-verbose …`.  rpm itself execve()s the path with "gpg"
# as argv[0], so that word never reaches us — but a caller that routes the same
# macro text through a shell (`sh -c "$(rpm --eval %__gpg_sign_cmd)"`) leaves it
# behind as an operand, where it would trip the arity check below.  Drop it;
# nobody signs a file called `gpg`.
filtered=()
for p in ${positional[@]+"${positional[@]}"}; do
    case ${p##*/} in
    gpg | gpg2) continue ;;
    esac
    filtered+=("$p")
done

if ((${#filtered[@]} > 1)); then
    die "expected exactly one input file, got ${#filtered[@]}: ${filtered[*]}
(signing several files in one call is a gpg feature this shim does not have)"
fi
# gpg signs standard input when the operand is `-`, or when there is no operand
# at all.  That is not an edge case here: it is how rpm feeds a package to the
# signer.  rpm 4.16 and 4.19 both pipe the header+payload to be signed over
# stdin and pass `-` as the file name, so a shim that only understands real
# paths cannot sign an rpm at all.
plaintext=${filtered[0]-'-'}

[[ -n $output ]] ||
    die "no output path given; pass -o/--output <file> (rpm supplies it via -sbo)"

if [[ -z $key_label ]]; then
    die "no signing key given.
Pass -u <CKA_LABEL>, or set SQ_PKCS11_KEY_LABEL.  Under rpmsign that means
--define \"_gpg_name <CKA_LABEL>\"; the value is the HSM object's CKA_LABEL,
not an email address or a fingerprint."
fi

# sq-pkcs11 picks its hash to match the signing key's strength (P-256/SHA-256,
# P-384/SHA-384, P-521/SHA-512, RSA/SHA-512) and has no override.  The hash is
# recorded in the signature itself, so verifiers read it from there rather than
# being told out of band, and both rpm parsers do exactly that — an ignored
# request is a cosmetic difference, not a verification failure.  Say so once,
# only when something actually asked.
if [[ -n $digest_algo ]]; then
    warn "ignoring --digest-algo $digest_algo: sq-pkcs11 selects the digest to match the signing key"
fi

# ---------------------------------------------------------------------------
# Build and run the sq-pkcs11 command.
# ---------------------------------------------------------------------------

sq=${SQ_PKCS11_BIN:-sq-pkcs11}
command -v "$sq" >/dev/null ||
    die "sq-pkcs11 not found (looked for ${sq@Q}); set SQ_PKCS11_BIN to its path"

# sq-pkcs11 signs a named file, so a stdin operand has to be spooled.  Signing
# straight from the pipe is not an option anyway: the OpenPGP signature is over
# a hash of the whole input, so it cannot be emitted until the last byte has
# arrived.  Mode 0600 via mktemp, in a private directory, removed on any exit —
# the bytes are a package about to be published, not a secret, but they are the
# bytes being attested to and must not be swappable for something else
# mid-signature.
spool=
if [[ $plaintext == - ]]; then
    if [[ -t 0 ]]; then
        die "no input file given, and stdin is a terminal.
Expected a gpg-style detached-sign command line such as:
  $PROG --no-armor -u <CKA_LABEL> -sbo <signature-file> <file>"
    fi
    spool=$(mktemp -d "${TMPDIR:-/tmp}/$PROG.XXXXXX")
    trap 'rm -rf -- "$spool"' EXIT INT TERM
    plaintext=$spool/plaintext
    cat >"$plaintext"
fi

# --force: gpg's -o overwrites, and callers rely on that.  rpm in particular
# creates the signature file with mkstemp before invoking us, so without
# --force sq-pkcs11's refuse-to-clobber guard would reject every rpmsign run.
argv=("$sq" sign --force --key-label "$key_label")

if ((cleartext)); then
    argv+=(--cleartext)
elif ((!armor)); then
    argv+=(--binary)
fi

[[ -n ${SQ_PKCS11_CERT:-} ]] && argv+=(--input-cert "$SQ_PKCS11_CERT")
[[ -n ${SQ_PKCS11_CREATION_TIME:-} ]] && argv+=(--creation-time "$SQ_PKCS11_CREATION_TIME")
[[ -n ${SQ_PKCS11_PIN_FILE:-} ]] && argv+=(--pin-file "$SQ_PKCS11_PIN_FILE")

# `--` guards against an input path that begins with a dash.
argv+=(--output "$output" -- "$plaintext")

unset SQ_PKCS11_PIN SQ_PKCS11_SUBKEY_PIN

if [[ -z $spool ]]; then
    exec "${argv[@]}"
fi
# With a spool directory to clean up we cannot exec; run and forward the status
# so the EXIT trap fires.
status=0
"${argv[@]}" || status=$?
exit "$status"
