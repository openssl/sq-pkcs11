#!/usr/bin/env bash
#
# sq-pkcs11-gpg-shim — a gpg(1)-compatible front end for `sq-pkcs11 sign`.
#
# Lets tools that sign by exec'ing a gpg command line sign against a PKCS#11
# HSM instead, with no private key on disk and no gpg-agent.  Two callers drive
# it, and their command lines differ in ways that are load-bearing.
#
# rpmsign --addsign, through rpm's %__gpg_sign_cmd:
#
#     gpg --no-verbose --no-armor [--digest-algo=X] -u <_gpg_name> \
#         -sbo <signature-file> -
#
#   The data arrives on STDIN — both rpm 4.16.1.3 (EL9) and 4.19.1.1 (EL10)
#   pass `-` and pipe the package in — the binary detached signature must land
#   on the -o path, and rpm 4.19 probes `--version` first, giving up if it
#   exits non-zero.
#
# git, through `gpg.program` (gpg-interface.c):
#
#     gpg --status-fd=2 -bsau <keyid> < payload > armored_signature
#
#   No -o at all: the signature goes to STDOUT.  And the SIG_CREATED status
#   line is mandatory — git scans for it and fails the signing without it,
#   however good the signature (checked on git 2.55).
#
# Signing only: detached (binary or armored) and cleartext.  Verification,
# encryption and key management are errors rather than silent no-ops.  They are
# also things gpg and sq already do, and an HSM adds nothing to them, so
# `git tag -v` and `gpg --verify` want the real tool.
#
# ─── Configuration ──────────────────────────────────────────────────────────
#
# The command line carries the key name and the paths; the rest comes from the
# environment:
#
#   PKCS11_MODULE_PATH       Vendor PKCS#11 library.  Required (or SQ_PKCS11_MODULE).
#   SQ_PKCS11_CERT           Published cert, passed as --input-cert: derives the
#                            key-creation time by matching the HSM key's public
#                            material.  Preferred — nothing to keep in sync.
#   SQ_PKCS11_CREATION_TIME  RFC 3339 key-creation time, passed as
#                            --creation-time.  One of these two is required;
#                            sq-pkcs11 refuses to guess.  A wrong value yields a
#                            signature whose issuer fingerprint matches no
#                            published key.
#   SQ_PKCS11_KEY_LABEL      CKA_LABEL used when the caller passes no -u (rpm
#                            4.19 omits it when %_gpg_name is unset).  An
#                            explicit -u wins.
#   SQ_PKCS11_PIN_FILE       Passed as --pin-file, for a softcard or K=1 OCS
#                            key.  Omit for a module-protected key, which is
#                            the unattended case.
#   SQ_PKCS11_BIN            sq-pkcs11 to run.  Default: `sq-pkcs11` on PATH.
#
# SQ_PKCS11_PIN and SQ_PKCS11_SUBKEY_PIN are removed from the environment
# first: they switch sq-pkcs11 into PKCS#11 login mode, a module-protected key
# needs login mode None, and an inherited value would change which slot is
# selected.  SQ_PKCS11_PIN_FILE is the only way in.
#
# ─── Wiring it up ───────────────────────────────────────────────────────────
#
#   rpmsign --addsign --define "_gpg_name <CKA_LABEL>" \
#           --define "__gpg $(command -v sq-pkcs11-gpg-shim)" package.rpm
#
#   git -c gpg.program=$(command -v sq-pkcs11-gpg-shim) \
#       tag -s -u <CKA_LABEL> <tag> -m <message>
#
# Overriding %__gpg alone keeps the distro's own %__gpg_sign_cmd, so the
# contract stays whatever that rpm version expects; override %__gpg_sign_cmd
# itself to add sq-pkcs11 flags.  Give git `gpg.program` per command rather
# than in config, so `git tag -v` still reaches a real gpg.  %_gpg_name and -u
# are both the HSM CKA_LABEL: -u becomes --key-label, not a search over user
# IDs, so an email address or fingerprint will not resolve.
#
set -euo pipefail

readonly PROG=${0##*/}

die() {
    printf '%s: %s\n' "$PROG" "$*" >&2
    exit 1
}

warn() {
    printf '%s: %s\n' "$PROG" "$*" >&2
}

# in_list <needle> <item>...
in_list() {
    local needle=$1 item
    shift
    for item in "$@"; do
        [[ $item == "$needle" ]] && return 0
    done
    return 1
}

# ---------------------------------------------------------------------------
# Argument parsing.
#
# Tolerant by design: a caller's command line carries options that have no
# bearing on what we do (keyring paths, fd plumbing, verbosity), and rejecting
# them would mean chasing every distro's macro edits and every git release.
# Options that would change the *meaning* of the operation are not dropped.
# ---------------------------------------------------------------------------

key_label=${SQ_PKCS11_KEY_LABEL:-}
output=
status_fd=
digest_algo=
armor=0
cleartext=0
positional=()

# Long options whose value must still be consumed, or it would be left behind
# as an operand and mistaken for the file to sign.
value_consuming_ignored=(
    --homedir --keyring --secret-keyring --primary-keyring --trustdb-name
    --options --passphrase --passphrase-fd --passphrase-file --pinentry-mode
    --logger-fd --attribute-fd --command-fd --log-file
    --set-filename --comment --cert-digest-algo --compress-algo --compress-level
    --personal-digest-preferences --personal-cipher-preferences
    --personal-compress-preferences --trust-model --keyid-format --display-charset
    --s2k-digest-algo --s2k-cipher-algo --s2k-mode --s2k-count --sender
    --request-origin --known-notation --agent-program --dirmngr-program
)

while (($#)); do
    arg=$1
    shift
    case $arg in
    # ── things we act on ────────────────────────────────────────────────
    -u | --local-user | --default-key)
        (($#)) || die "$arg requires a value"
        key_label=$1
        shift
        ;;
    --local-user=* | --default-key=*)
        key_label=${arg#*=}
        ;;
    -o | --output)
        (($#)) || die "$arg requires a value"
        output=$1
        shift
        ;;
    --output=*)
        output=${arg#*=}
        ;;
    --status-fd)
        (($#)) || die "$arg requires a value"
        status_fd=$1
        shift
        ;;
    --status-fd=*)
        status_fd=${arg#*=}
        ;;
    --armor | --armour | --enarmor)
        armor=1
        ;;
    --no-armor | --no-armour)
        armor=0
        ;;
    --clearsign | --clear-sign)
        cleartext=1
        ;;
    --digest-algo)
        (($#)) || die "$arg requires a value"
        digest_algo=$1
        shift
        ;;
    --digest-algo=*)
        digest_algo=${arg#*=}
        ;;

    # rpm 4.19 treats a non-zero exit here as "gpg is broken", so answering is
    # load-bearing.  The first line is what a caller sniffing for GnuPG matches
    # on; the rest says what this actually is.
    --version)
        echo "gpg (GnuPG) 2.4.0"
        echo "$PROG: gpg-compatible signing front end for sq-pkcs11"
        "${SQ_PKCS11_BIN:-sq-pkcs11}" --version 2>/dev/null ||
            echo "sq-pkcs11: not found on PATH"
        exit 0
        ;;

    # End of options.  rpm 4.19 emits `-sbo <sigfile> -- -`, so this arrives.
    --)
        while (($#)); do
            positional+=("$1")
            shift
        done
        ;;

    # ── operations we cannot perform: fail, never pretend ───────────────
    --verify | --verify-files | --decrypt | --encrypt | --symmetric | \
        --list-keys | --list-secret-keys | --export | --export-secret-keys | \
        --import | --gen-key | --full-gen-key | --quick-gen-key | \
        --delete-key | --delete-secret-key | --edit-key | --sign-key | \
        --gen-revoke | --card-status | --card-edit | --change-pin)
        die "$arg is not supported; this shim only creates signatures with an HSM key.
Verification and keyring work need real gpg or sq, which an HSM adds nothing
to; certificate export and revocation are sq-pkcs11 subcommands of their own.
For git, that means giving gpg.program per command rather than in config, so
\`git tag -v\` still reaches a real gpg."
        ;;

    # ── boilerplate: understood, irrelevant, dropped ────────────────────
    --sign | -s | --detach-sign | --detach-sig | --textmode | -t | \
        --no-verbose | --verbose | -v | --quiet | -q | --batch | --no-batch | \
        --yes | --no-tty | --no-secmem-warning | --no-permission-warning | \
        --no-default-keyring | --no-options | --no-greeting | --no-armor-warning | \
        --emit-version | --no-emit-version | --no-mdc-warning | --force-v3-sigs | \
        --no-force-v3-sigs | --enable-progress-filter | --lock-never | \
        --lock-once | --lock-multiple | --always-trust | --trust-model-always | \
        --no-auto-check-trustdb | --no-random-seed-file | --utf8-strings | \
        --no-utf8-strings | --rfc4880 | --rfc2440 | --openpgp | --gnupg | \
        --no-use-agent | --use-agent | --debug-quick-random | --no-comments)
        ;;
    --*)
        # Split "--flag=value" so the bare name can be looked up.
        name=${arg%%=*}
        if in_list "$name" "${value_consuming_ignored[@]}"; then
            # Only eat a following token for the space-separated spelling.
            if [[ $arg != *=* ]] && (($#)); then
                shift
            fi
        else
            warn "ignoring unrecognised option $name"
        fi
        ;;

    # ── short-option clusters: -b, -sb, -sbo FILE, -uNAME, git's -bsau ──
    -?*)
        rest=${arg#-}
        while [[ -n $rest ]]; do
            opt=${rest:0:1}
            rest=${rest:1}
            case $opt in
            o)
                if [[ -n $rest ]]; then
                    output=$rest
                    rest=
                elif (($#)); then
                    output=$1
                    shift
                else
                    die "-o requires a value"
                fi
                ;;
            u)
                if [[ -n $rest ]]; then
                    key_label=$rest
                    rest=
                elif (($#)); then
                    key_label=$1
                    shift
                else
                    die "-u requires a value"
                fi
                ;;
            a) armor=1 ;;
            # sign / detach / textmode / verbose / quiet / dry-run: implied
            # or irrelevant.
            s | b | t | v | q | n) ;;
            *) warn "ignoring unrecognised option -$opt" ;;
            esac
        done
        ;;

    # ── operands ────────────────────────────────────────────────────────
    *)
        positional+=("$arg")
        ;;
    esac
done

# Both rpm versions expand %__gpg_sign_cmd to `<path-to-gpg> gpg --no-verbose
# …`.  rpm execve()s the path with "gpg" as argv[0] so the word never reaches
# us, but routing the same macro text through a shell leaves it behind as an
# operand, where it would trip the arity check below.  Nobody signs a file
# called `gpg`.
filtered=()
for p in ${positional[@]+"${positional[@]}"}; do
    case ${p##*/} in
    gpg | gpg2) continue ;;
    esac
    filtered+=("$p")
done

if ((${#filtered[@]} > 1)); then
    die "expected exactly one input file, got ${#filtered[@]}: ${filtered[*]}
(signing several files in one call is a gpg feature this shim does not have)"
fi

# gpg reads stdin when the operand is `-` or absent, and both callers rely on
# it: rpm passes `-` and pipes the package, git passes no operand at all.
plaintext=${filtered[0]-'-'}

# Likewise gpg writes to stdout when there is no -o, which is the only way git
# can receive a signature.
[[ -n $output ]] || output=-

if [[ -z $key_label ]]; then
    die "no signing key given.
Pass -u <CKA_LABEL>, or set SQ_PKCS11_KEY_LABEL.  Under rpmsign that means
--define \"_gpg_name <CKA_LABEL>\"; under git, user.signingkey.  The value is
the HSM object's CKA_LABEL, not an email address or a fingerprint — note that
git falls back to the committer identity, which is such an address."
fi

# sq-pkcs11 picks the hash to match the signing key's strength and has no
# override.  The choice is recorded in the signature, where verifiers read it
# from, so an ignored request is cosmetic — but say so when something asks.
if [[ -n $digest_algo ]]; then
    warn "ignoring --digest-algo $digest_algo: sq-pkcs11 selects the digest to match the signing key"
fi

# ---------------------------------------------------------------------------
# Build and run the sq-pkcs11 command.
# ---------------------------------------------------------------------------

sq=${SQ_PKCS11_BIN:-sq-pkcs11}
command -v "$sq" >/dev/null ||
    die "sq-pkcs11 not found (looked for ${sq@Q}); set SQ_PKCS11_BIN to its path"

# sq-pkcs11 signs a named file, so stdin has to be spooled.  Signing from the
# pipe is impossible anyway: the signature is over a hash of the whole input.
# A private directory, removed on any exit — these are the bytes being attested
# to, and must not be swappable for something else mid-signature.
spool=
if [[ $plaintext == - ]]; then
    if [[ -t 0 ]]; then
        die "no input file given, and stdin is a terminal.
Expected a gpg-style detached-sign command line such as:
  $PROG --no-armor -u <CKA_LABEL> -sbo <signature-file> <file>"
    fi
    spool=$(mktemp -d "${TMPDIR:-/tmp}/$PROG.XXXXXX")
    trap 'rm -rf -- "$spool"' EXIT INT TERM
    plaintext=$spool/plaintext
    cat >"$plaintext"
fi

# --force: gpg's -o overwrites and callers rely on it.  rpm creates the
# signature file with mkstemp before invoking us, so without --force
# sq-pkcs11's refuse-to-clobber guard would reject every rpmsign run.
argv=("$sq" sign --force --key-label "$key_label")

if ((cleartext)); then
    argv+=(--cleartext)
elif ((!armor)); then
    argv+=(--binary)
fi

[[ -n ${SQ_PKCS11_CERT:-} ]] && argv+=(--input-cert "$SQ_PKCS11_CERT")
[[ -n ${SQ_PKCS11_CREATION_TIME:-} ]] && argv+=(--creation-time "$SQ_PKCS11_CREATION_TIME")
[[ -n ${SQ_PKCS11_PIN_FILE:-} ]] && argv+=(--pin-file "$SQ_PKCS11_PIN_FILE")

# `--` guards against an input path that begins with a dash.
argv+=(--output "$output" -- "$plaintext")

unset SQ_PKCS11_PIN SQ_PKCS11_SUBKEY_PIN

# exec only when there is nothing left to do afterwards: a spool to remove
# needs the EXIT trap, and a status line needs us to outlive sq-pkcs11.
if [[ -z $spool && -z $status_fd ]]; then
    exec "${argv[@]}"
fi
status=0
"${argv[@]}" || status=$?
((status == 0)) || exit "$status"

# git requires this line, per the note at the top; rpm never asks for it.
# Fields are per GnuPG's doc/DETAILS —
#   SIG_CREATED <type> <pk_algo> <hash_algo> <class> <timestamp> <fpr>
# — but git matches the keyword and reads none of them, and we have no
# fingerprint to offer, so the rest are placeholders.  The leading newline
# guarantees the line boundary git's search needs.  Never onto fd 1: that
# carries the signature, and the line would land inside the armor.
if [[ -n $status_fd && $status_fd != 1 ]]; then
    printf '\n[GNUPG:] SIG_CREATED D 1 10 00 %d sq-pkcs11\n' "$(date -u +%s)" \
        >&"$status_fd" 2>/dev/null || true
fi
